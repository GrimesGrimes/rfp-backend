# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================
# Este archivo contiene todas las variables de entorno necesarias para el backend.
# Copia este archivo como .env y ajusta los valores según tu entorno.
#
# IMPORTANTE: 
# - NO subas el archivo .env con valores reales a Git
# - Los valores mostrados aquí son para DESARROLLO
# - En PRODUCCIÓN, usa los valores apropiados de tu entorno de deployment
# ========================================

# === Environment ===
# Valores: "development" | "test" | "production"
# Desarrollo: "development"
# Producción: "production"
NODE_ENV="development"

# Puerto en el que escucha el servidor backend
# Desarrollo: 3001 (o cualquier puerto libre)
# Producción: Railway asigna automáticamente (usa process.env.PORT)
PORT=3001

# === Database ===
# Cadena de conexión a PostgreSQL
# Formato: postgresql://<usuario>:<password>@<host>:<port>/<dbname>?schema=public
# 
# Desarrollo: Apunta a tu Postgres local o contenedor Docker
# Ejemplo: "postgresql://postgres:mysecretpassword@localhost:5432/rfp_db?schema=public"
# 
# Producción: Railway proporciona esta variable automáticamente
# Ejemplo: "postgresql://user:pass@containers-us-west-xxx.railway.app:7432/railway"
DATABASE_URL="postgresql://postgres:password@localhost:5432/rfp_db?schema=public"

# Base de datos shadow (opcional, para Prisma migrations en producción)
# Desarrollo: No es necesario
# Producción: Solo si usas migrations con Prisma en producción
# SHADOW_DATABASE_URL=""

# === Auth ===
# Secreto para firmar JWT tokens (mínimo 32 caracteres)
# IMPORTANTE: Usa un valor aleatorio y seguro en producción
# 
# Desarrollo: Cualquier string de 32+ caracteres
# Producción: Genera un secreto criptográficamente seguro
# Ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_secure_jwt_secret_here_at_least_32_characters_long"

# === API Configuration ===
# Orígenes permitidos para CORS (separados por coma si son múltiples)
# 
# Desarrollo: URL de tu frontend local
# Ejemplo: "http://localhost:5173"
# 
# Producción: URL(s) de tu frontend desplegado
# Ejemplo: "https://tu-app.vercel.app,https://www.tu-app.com"
CORS_ORIGIN="http://localhost:5173"

# === AI / OpenRouter ===
# API Key de OpenRouter (https://openrouter.ai/)
# IMPORTANTE: No compartas esta clave públicamente
# 
# Desarrollo y Producción: Usa la misma clave de OpenRouter
# Formato: "sk-or-v1-xxxxx..."
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"

# URL base de la API de OpenRouter (normalmente no necesitas cambiar esto)
OPENROUTER_BASE="https://openrouter.ai/api/v1"

# Modelo de LLM a usar para generación de texto
# Desarrollo: Puedes usar modelos gratuitos para testing
# Producción: Considera modelos más potentes según tu presupuesto
# Ejemplos: "deepseek/deepseek-chat-v3.1", "openai/gpt-4", etc.
LLM_MODEL="deepseek/deepseek-chat-v3.1:free"

# Modelo de embeddings para búsqueda semántica
# Desarrollo y Producción: Normalmente el mismo modelo
EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"

# === App Metadata (for OpenRouter headers) ===
# URL pública de tu aplicación (opcional, usado en headers de OpenRouter)
# Desarrollo: "http://localhost:5173"
# Producción: URL de tu app desplegada
APP_PUBLIC_URL="http://localhost:5173"

# Título de tu aplicación (opcional, usado en headers de OpenRouter)
APP_TITLE="RFP-Studio"

# === Caching ===
# Tiempo de vida (TTL) del caché de respuestas de AI en segundos
# 86400 segundos = 24 horas
# Ajusta según tus necesidades (mínimo 60 segundos)
AI_CACHE_TTL_SECONDS=86400

# === Seeds / Optional ===
# URL de la API para scripts de seed (opcional)
# Desarrollo: "http://localhost:3001"
# Producción: URL de tu API desplegada
SEED_API_URL="http://localhost:3001"

# === Variables Opcionales Adicionales ===
# Estas variables son alternativas a las principales arriba
# Solo necesitas definirlas si quieres sobrescribir los valores por defecto

# Alternativa a OPENROUTER_BASE (si no se define, se usa OPENROUTER_BASE)
# LLM_BASE="https://openrouter.ai/api/v1"

# Alternativa a OPENROUTER_API_KEY (si no se define, se usa OPENROUTER_API_KEY)
# LLM_KEY="sk-or-v1-xxxxx..."

# Modelos de fallback para LLM (separados por coma)
# Si el modelo principal falla, se probarán estos modelos en orden
# LLM_FALLBACK="openai/gpt-4o-mini,meta-llama/llama-3.1-8b-instruct,qwen/qwen-2.5-7b-instruct"

