{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "*": ["node_modules/*", "src/types/*"]
      },
      "strict": true,
      "esModuleInterop": true,
      "outDir": "dist",
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "rootDirs": ["./src"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }